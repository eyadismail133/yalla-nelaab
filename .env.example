# Copy to .env for local overrides. Every value here is optional — the defaults are what
# `npm run dev` uses, and they are chosen so the game runs with no configuration at all.

# Port the game server listens on. In production it serves the built client from this port too.
PORT=3001

# Where the question bank lives. Only worth setting if the seed files move.
# SEED_DIR=./content/seed

# Where the built client lives. Set this if the web build is deployed somewhere unusual;
# leave it unset and the server finds apps/web/dist next to itself, or runs headless if the
# client has not been built.
# WEB_DIST=./apps/web/dist

# Socket.IO CORS origin.
#
# Defaults to allowing any origin, which is what makes eight phones on a LAN work with no setup.
# In a deploy where the server also serves the client (the default) the browser never makes a
# cross-origin request, so this stays irrelevant. Set it only when the client is hosted
# somewhere else — then set it to exactly that origin.
# CLIENT_ORIGIN=https://yalla-nelaab.example.com

# Dev only: where Vite proxies /socket.io to. Change if the game server is not on 3001.
# GAME_SERVER_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Multiplayer transport selection & Firebase Spark configuration
# ---------------------------------------------------------------------------
# Transport mode:
# - 'socket' (default in `npm run dev`) uses the local Socket.IO server.
# - 'firebase' (used by `npm run build:firebase`) runs the host engine in the
#   creator's browser tab over Firebase Anonymous Auth + Realtime Database.
# VITE_GAME_TRANSPORT=socket

# Public Firebase Web SDK configuration (safe to expose in client bundles; not an admin secret).
# `npm run build:firebase` uses the verified Spark project defaults if not overridden:
# VITE_FIREBASE_PROJECT_ID=yalla-nelaab-20261016
# VITE_FIREBASE_APP_ID=1:748713989802:web:e37cbc40c93efee8b6e2d3
# VITE_FIREBASE_API_KEY=AIzaSyCP-NozgksAuJ2tSe06zk5ipLFIIMlMbyM
# VITE_FIREBASE_AUTH_DOMAIN=yalla-nelaab-20261016.firebaseapp.com
# VITE_FIREBASE_DATABASE_URL=https://yalla-nelaab-20261016-default-rtdb.europe-west1.firebasedatabase.app

# Optional local Firebase Emulator overrides (host:port):
# Local emulator tests (`npm run test:firebase:rules` and `npm run test:emulator`) require
# Node.js >= 24.12.0 (for `@firebase/rules-unit-testing@^6.0.0`) and Java 21+.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# ---------------------------------------------------------------------------
# Targeted RTDB expired-record cleanup & code preservation rules
# ---------------------------------------------------------------------------
# The Firebase Spark plan has no scheduled Cloud Functions or automated TTL expiration.
# Room and code records expire in security rules 6 hours after creation (`expiresAtMs <= now`).
# Note: Runtime client-assisted cleanup is currently partial and under active development;
# do not rely on automatic background purges.
#
# CRITICAL ADMIN SAFETY RULES:
# 1. NEVER delete the root `/rooms` or `/codes` trees. Doing so instantly destroys all active matches!
# 2. CODES ARE REUSED: A 5-character code (e.g. `/codes/ABCDE`) can be reassigned to a brand-new
#    active room once the original match expires or closes.
#    BEFORE deleting any `/codes/<CODE>` node, you MUST inspect its current value:
#    - Read `/codes/<CODE>`.
#    - Verify that its `roomId` field matches the specific expired room ID you intend to clean up.
#    - Verify that `/codes/<CODE>/expiresAtMs` is in the past OR the room is confirmed closed.
#    - If `/codes/<CODE>/roomId` points to a DIFFERENT room or a live match, DO NOT DELETE IT.
#      Preserve the reassigned live mapping.
# 3. Always re-verify targeted keys immediately before issuing any manual deletion.
#
# Manual cleanup procedure in Firebase Console:
# 1. Open Firebase Console -> Realtime Database -> Data.
# 2. Inspect `/rooms/<EXPIRED_ROOM_ID>/meta` to verify `status === "closed"` or `expiresAtMs <= now`.
# 3. Inspect `/codes/<CODE>` and confirm `roomId === "<EXPIRED_ROOM_ID>"`.
# 4. Delete the specific `/rooms/<EXPIRED_ROOM_ID>` node.
# 5. Delete `/codes/<CODE>` ONLY IF its `roomId` still matched `<EXPIRED_ROOM_ID>`.
#
# Manual cleanup via Firebase CLI (inspect first, delete targeted nodes only):
#   # Inspect:
#   firebase database:get /rooms/<EXPIRED_ROOM_ID>/meta --project yalla-nelaab-20261016
#   firebase database:get /codes/<CODE> --project yalla-nelaab-20261016
#   # Delete room:
#   firebase database:remove /rooms/<EXPIRED_ROOM_ID> --project yalla-nelaab-20261016
#   # Delete code ONLY IF it still mapped to <EXPIRED_ROOM_ID>:
#   firebase database:remove /codes/<CODE> --project yalla-nelaab-20261016
